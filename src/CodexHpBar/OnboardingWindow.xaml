<Window x:Class="CodexHpBar.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex HP Bar 首次啟用" Width="460" Height="410"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFF9FB"
        Icon="Assets/cat-pig.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="🐱🐷" FontSize="34" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="歡迎使用 Codex HP Bar" FontSize="22" FontWeight="Bold" Foreground="#2D2337"/>
                <TextBlock Text="像素貓咪豬會在工具列陪你查看剩餘額度。" Foreground="#65586E" Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="#FFF0F4" CornerRadius="10" Padding="14" Margin="0,22,0,18">
            <TextBlock TextWrapping="Wrap" Foreground="#514659">本程式只透過本機 Codex app-server 讀取額度，不會讀取或上傳登入權杖。以下設定之後可由血條右鍵選單變更。</TextBlock>
        </Border>
        <StackPanel Grid.Row="2">
            <CheckBox x:Name="BackgroundBox" Content="允許 Codex HP Bar 在背景待命" FontSize="15" Margin="0,5" Checked="BackgroundChanged" Unchecked="BackgroundChanged"/>
            <TextBlock Text="Codex 關閉時隱藏，繼續等待下次開啟。" Margin="24,0,0,10" Foreground="#776A80"/>
            <CheckBox x:Name="StartupBox" Content="登入 Windows 時自動啟動" FontSize="15" Margin="0,5" Checked="StartupChecked" Unchecked="StartupUnchecked"/>
            <TextBlock Text="會建立使用者 Startup 捷徑，不需要系統管理員權限。" Margin="24,0,0,0" Foreground="#776A80"/>
            <Border Background="#EEF9F7" CornerRadius="7" Padding="10,7" Margin="24,12,0,0">
                <TextBlock x:Name="StartupStatusText" Foreground="#28645D" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="82" Margin="0,0,10,0" Click="CancelClick"/>
            <Button Content="套用並啟用" Width="120" Padding="8" Background="#FF5D73" Foreground="White" BorderThickness="0" Click="ApplyClick"/>
        </StackPanel>
    </Grid>
</Window>
