<Window x:Class="CodexHpBar.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex HP Bar 首次啟用" Width="560" Height="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FFF9FB"
        Icon="Assets/mushroom.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/mushroom.png" Width="58" Height="50" Stretch="Uniform" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="歡迎使用 Codex HP Bar" FontSize="22" FontWeight="Bold" Foreground="#2D2337"/>
                <TextBlock Text="菇菇寶貝會在工具列陪你查看剩餘額度。" Foreground="#65586E" Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="#FFF0F4" CornerRadius="10" Padding="14" Margin="0,22,0,16">
            <TextBlock TextWrapping="Wrap" Foreground="#514659">本程式只透過本機 Codex app-server 讀取額度，不會讀取或上傳登入權杖。圖片只會在本機讀取，以下設定之後可由血條右鍵選單變更。</TextBlock>
        </Border>
        <GroupBox Grid.Row="2" Header="工具列角色圖片" Padding="12" Margin="0,0,0,16" Foreground="#2D2337">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ComboBox x:Name="MascotModeBox" SelectedValuePath="Tag" SelectionChanged="MascotModeChanged" MinHeight="28">
                    <ComboBoxItem Tag="BuiltInMushroom" Content="內建菇菇寶貝（推薦）"/>
                    <ComboBoxItem Tag="StaticImage" Content="靜態圖片（PNG、JPG、BMP、ICO）"/>
                    <ComboBoxItem Tag="AnimatedGif" Content="GIF 動圖（使用 GIF 內建速度）"/>
                    <ComboBoxItem Tag="SpriteSheet4x4" Content="4×4 連續動畫圖片（16 影格）"/>
                </ComboBox>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MascotPathBox" IsReadOnly="True" Padding="7,4" VerticalContentAlignment="Center" ToolTip="圖片只會從本機讀取。"/>
                    <Button x:Name="BrowseMascotButton" Grid.Column="1" Content="選擇檔案" Margin="8,0,0,0" Padding="12,4" Click="BrowseMascotClick"/>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="4×4 影格速度（FPS）" VerticalAlignment="Center" Foreground="#514659"/>
                    <TextBox x:Name="FrameRateBox" Width="52" Text="8" Margin="10,0,0,0" Padding="5,3" TextAlignment="Center"/>
                    <TextBlock Text="建議 8–12；GIF 會使用檔案自己的影格時間。" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#776A80"/>
                </StackPanel>
                <TextBlock x:Name="MascotRuleText" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#776A80"/>
            </Grid>
        </GroupBox>
        <StackPanel Grid.Row="3">
            <CheckBox x:Name="BackgroundBox" Content="允許 Codex HP Bar 在背景待命" FontSize="15" Margin="0,5" Checked="BackgroundChanged" Unchecked="BackgroundChanged"/>
            <TextBlock Text="Codex 關閉時隱藏，繼續等待下次開啟。" Margin="24,0,0,10" Foreground="#776A80"/>
            <CheckBox x:Name="StartupBox" Content="登入 Windows 時自動啟動" FontSize="15" Margin="0,5" Checked="StartupChecked" Unchecked="StartupUnchecked"/>
            <TextBlock Text="會建立使用者 Startup 捷徑，不需要系統管理員權限。" Margin="24,0,0,0" Foreground="#776A80"/>
            <Border Background="#EEF9F7" CornerRadius="7" Padding="10,7" Margin="24,12,0,0">
                <TextBlock x:Name="StartupStatusText" Foreground="#28645D" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="82" Margin="0,0,10,0" Click="CancelClick"/>
            <Button Content="套用並啟用" Width="120" Padding="8" Background="#FF5D73" Foreground="White" BorderThickness="0" Click="ApplyClick"/>
        </StackPanel>
    </Grid>
</Window>
